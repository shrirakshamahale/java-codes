import java.util.*;

public class switch1 {
    public static void main(String[] args ){
        Scanner sc=new Scanner(System.in);
        String fruit=sc.next();
        switch(fruit){
            case "mango":
                System.out.println("king of fruits");
                break;
            case "apple":
                System.out.println("red ");
                break;
            default:
                System.out.println("there is no fruits");
                break;
        }

    }
    
}
